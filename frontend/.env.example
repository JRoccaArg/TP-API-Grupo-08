# Destino del backend para el proxy de desarrollo y preview.
# Copiar a .env.local para configurar otro destino sin versionar ajustes particulares.
ZENOIR_API_TARGET=http://127.0.0.1:8080

# Dirección desde la que se abre el sitio. Va dentro del QR de cada entrada: http://<esto>/verificar/<código>.
# Para escanear los QR con un celular, poné la IP de tu PC (ej. http://192.168.0.15:5173) y levantá el front con: npm run dev -- --host
VITE_URL_PUBLICA=http://localhost:5173
